#!/bin/bash
set -o errexit
set -o nounset
set -o pipefail

SEMVER_REGEX='^v([0-9]+)\.([0-9]+)\.([0-9]+)(-([0-9A-Za-z.-]+))?(\+([0-9A-Za-z.-]+))?$'

find_latest_release_tag() {
  local tag major minor patch best_tag="v0.0.0"
  local best_major=0 best_minor=0 best_patch=0

  while IFS= read -r tag; do
    if [[ "${tag}" =~ ${SEMVER_REGEX} ]]; then
      major="${BASH_REMATCH[1]}"
      minor="${BASH_REMATCH[2]}"
      patch="${BASH_REMATCH[3]}"
      local prerelease="${BASH_REMATCH[5]:-}"

      [[ -n "${prerelease}" ]] && continue

      git merge-base --is-ancestor "${tag}" HEAD 2>/dev/null || continue

      if (( major > best_major )) || \
         (( major == best_major && minor > best_minor )) || \
         (( major == best_major && minor == best_minor && patch > best_patch )); then
        best_major="${major}"
        best_minor="${minor}"
        best_patch="${patch}"
        best_tag="${tag}"
      fi
    fi
  done < <(git tag --list 'v*' 2>/dev/null)

  echo "${best_tag}"
}

determine_bump() {
  local bump="patch"
  local line
  local has_delimiters=false
  local is_subject=true

  while IFS= read -r line || [[ -n "${line}" ]]; do
    if [[ "${line}" == "---COMMIT_DELIMITER---" ]]; then
      has_delimiters=true
      is_subject=true
      continue
    fi

    if [[ "${is_subject}" == true ]] && [[ "${has_delimiters}" == true ]] && [[ -z "${line}" ]]; then
      continue
    fi

    if [[ "${line}" =~ BREAKING[\ -]CHANGE ]]; then
      echo "major"
      return
    fi

    if [[ "${is_subject}" == true ]]; then
      if [[ "${has_delimiters}" == true ]]; then
        is_subject=false
      fi

      if [[ "${line}" =~ ^[a-zA-Z]+(\(.+\))?!: ]]; then
        echo "major"
        return
      fi

      if [[ "${line}" =~ ^[fF][eE][aA][tT](\(.+\))?: ]]; then
        bump="minor"
      fi
    fi
  done

  echo "${bump}"
}

apply_bump() {
  local version="$1" bump="$2"

  version="${version#v}"
  version="${version%%[-+]*}"
  local major="${version%%.*}"
  local rest="${version#*.}"
  local minor="${rest%%.*}"
  local patch="${rest#*.}"

  case "${bump}" in
    major)
      major=$((major + 1))
      minor=0
      patch=0
      ;;
    minor)
      minor=$((minor + 1))
      patch=0
      ;;
    patch)
      patch=$((patch + 1))
      ;;
  esac

  echo "v${major}.${minor}.${patch}"
}

branch_slug() {
  local branch="$1"
  echo "${branch}" | sed 's/[^0-9A-Za-z-]/-/g' | sed 's/--*/-/g' | sed 's/^-//;s/-$//'
}

auto_version_main() {
  local latest_tag
  latest_tag=$(find_latest_release_tag)

  if [[ ! "${latest_tag}" =~ ${SEMVER_REGEX} ]]; then
    echo "Error: latest tag '${latest_tag}' does not match semver2 format" >&2
    exit 1
  fi

  local commit_count
  if [[ "${latest_tag}" == "v0.0.0" ]]; then
    commit_count=$(git rev-list HEAD --count 2>/dev/null || echo "0")
  else
    commit_count=$(git rev-list "${latest_tag}..HEAD" --count 2>/dev/null || echo "0")
  fi

  if [[ "${commit_count}" -eq 0 ]]; then
    if [[ "${latest_tag}" == "v0.0.0" ]]; then
      echo "v0.0.1"
      return
    fi
    echo "Error: no commits since ${latest_tag}" >&2
    exit 1
  fi

  local bump
  if [[ "${latest_tag}" == "v0.0.0" ]]; then
    bump=$(git log --pretty=format:"---COMMIT_DELIMITER---%n%B" | determine_bump)
  else
    bump=$(git log "${latest_tag}..HEAD" --pretty=format:"---COMMIT_DELIMITER---%n%B" | determine_bump)
  fi

  apply_bump "${latest_tag}" "${bump}"
}

auto_version() {
  local version
  version=$(auto_version_main)

  local branch="${BUILDKITE_BRANCH:-$(git rev-parse --abbrev-ref HEAD)}"
  if [[ "${branch}" != "${BUILDKITE_PIPELINE_DEFAULT_BRANCH:-main}" ]]; then
    local slug
    slug=$(branch_slug "${branch}")
    version="${version}-preview.${slug}"
  fi

  echo "${version}"
}

if [[ "${BATS_TEST_SOURCED:-}" != "1" ]]; then
  auto_version
fi
